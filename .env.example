# Na Pista landing — public build-time configuration (NEXT_PUBLIC_*: inlined
# into the static HTML). Nothing here is a secret, and nothing secret may ever
# be added: this site has no server and every value ships to the browser.

# Canonical public origin of this site (required for production builds).
# Used for canonical URL, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=

# Na Pista Console sign-in page (required for production builds).
NEXT_PUBLIC_CONSOLE_LOGIN_URL=

# Optional overrides for the two contact CTAs (default: Última Linha's public
# contact e-mail / WhatsApp, as published on ultimalinha.ao).
NEXT_PUBLIC_START_URL=
NEXT_PUBLIC_CONTACT_URL=

# Optional Google Analytics 4 measurement ID (public by design). Empty = no
# third-party analytics script is loaded; events still reach window.dataLayer.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
